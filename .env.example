# CloakBrowser Manager — environment variables
# Copy to .env and edit. All variables are optional; defaults keep the
# manager fully functional with proxy management, profiles, and CDP.

# ---------------------------------------------------------------------------
# Authentication
# ---------------------------------------------------------------------------
# Set a strong token to require login before managing profiles over a
# tunnel. Leave blank to disable auth (only safe on a trusted local network).
AUTH_TOKEN=

# ---------------------------------------------------------------------------
# Resource limits (opt-in)
# ---------------------------------------------------------------------------
# Maximum number of concurrently running browser profiles. 0 = unlimited.
# Launching beyond the cap returns HTTP 429 "Max running profiles (N) reached".
MAX_RUNNING_PROFILES=0

# ---------------------------------------------------------------------------
# Proxy health monitoring (opt-in)
# ---------------------------------------------------------------------------
# Continuously re-test every saved proxy credential every N seconds and
# store exit IP / country / reachability on the credential. 0 = disabled
# (use the per-credential Test / Test-All buttons instead).
PROXY_HEALTH_CHECK_INTERVAL=0

# ---------------------------------------------------------------------------
# Local CDP bypass (opt-in, security-sensitive)
# ---------------------------------------------------------------------------
# When true, loopback requests (client IP 127.0.0.1/::1 or a loopback Host
# header) to /api/profiles/<id>/cdp/local/* skip auth, so tools like bdg can
# connect to page-level CDP without an auth-injecting bridge. Safe behind a
# reverse proxy/tunnel because the tunnel's client IP is not loopback.
# Default false — leave off unless you need the bridge-less local path.
ALLOW_LOCAL_CDP=false
